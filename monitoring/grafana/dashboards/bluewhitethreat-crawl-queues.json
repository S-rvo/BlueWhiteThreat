{
  "uid": "bwt-crawl-queues",
  "title": "Crawler et scraper — files Redis",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "bluewhitethreat",
    "crawler",
    "scraper"
  ],
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Crawler : files",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bwt_crawler_ready",
          "legendFormat": "prêtes"
        },
        {
          "refId": "B",
          "expr": "bwt_crawler_due",
          "legendFormat": "échues"
        },
        {
          "refId": "C",
          "expr": "bwt_crawler_future",
          "legendFormat": "futures"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Crawler : retard de la plus ancienne échéance",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bwt_crawler_oldest_due_seconds",
          "legendFormat": "retard"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scraper : files",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bwt_scraper_pending",
          "legendFormat": "prêtes"
        },
        {
          "refId": "B",
          "expr": "bwt_scraper_inflight",
          "legendFormat": "réservées"
        },
        {
          "refId": "C",
          "expr": "bwt_scraper_retry_due",
          "legendFormat": "retries échus"
        },
        {
          "refId": "D",
          "expr": "bwt_scraper_quarantined",
          "legendFormat": "quarantaine"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Scraper : résultats confirmés par heure",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(bwt_scraper_events_total{event=~\"success|transient|infrastructure|permanent|blocked|deferred\"}[1h]) * 3600",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Crawler : résultats et admissions par heure",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(bwt_crawler_events_total[1h]) * 3600",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scraper : réservations récupérées par heure",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(bwt_scraper_events_total{event=~\"released|recovered\"}[1h]) * 3600",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
