# Dockerfile.dev
FROM golang:1.24

WORKDIR /app/apps/scraper

COPY pkg/csamfilter /app/pkg/csamfilter
COPY pkg/contract /app/pkg/contract
COPY apps/scraper/go.mod apps/scraper/go.sum ./
RUN go mod download

COPY apps/scraper/. .
RUN mkdir -p data && printf '{}\n' > data/sites.json

# Run unit/integration tests. Faille si test KO !
RUN go test ./...

#pour chromdp
RUN apt-get update && \
    apt-get install -y chromium && \
    rm -rf /var/lib/apt/lists/*

# Build du binaire pour le contrôle
RUN go build -o scraper ./cmd

CMD ["./scraper"]
