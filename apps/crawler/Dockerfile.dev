FROM golang:1.24

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    iputils-ping \
    curl \
    vim \
    net-tools && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app/apps/crawler

# On copie d'abord le module partagé et les fichiers de dépendances
COPY pkg/csamfilter /app/pkg/csamfilter
COPY apps/crawler/go.mod apps/crawler/go.sum ./
RUN go mod download

# On copie le reste du code source
COPY apps/crawler/. .

CMD ["go", "run", "cmd/main.go"]
