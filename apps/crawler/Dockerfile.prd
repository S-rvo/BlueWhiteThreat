FROM golang:1.24-bookworm AS build
WORKDIR /src/apps/crawler
COPY pkg/csamfilter /src/pkg/csamfilter
COPY apps/crawler/go.mod apps/crawler/go.sum ./
RUN go mod download
COPY apps/crawler/cmd ./cmd
COPY apps/crawler/internal ./internal
COPY apps/crawler/tests ./tests
RUN go test ./...
RUN CGO_ENABLED=0 go build -trimpath -o /out/crawler ./cmd

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/crawler /usr/local/bin/crawler
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/crawler"]
