# Dedicated read-only user on BlueWhiteThreat; percent-encode credentials in the URI.
MONGODB_URI=
MONGO_DB=BlueWhiteThreat
# Optionnel : sans NEO4J_URI, /graph répond 503 et /data reste disponible.
# docker-compose les fournit déjà au service api.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
