classifier
*.csv
model.json
.env

# Local frozen experiment artifacts contain corpus text; keep out of source control.
/data/confirmation-campaign/
/data/.confirmation-history/

# Dated outputs of one-off cmd/ experiment tools (cv*, human-review-*, simhash-*,
# paired-ranking-*, train-*, docs reports, ...); never read by the production
# pipeline (cmd/main, cmd/train) and not meant to be committed.
/data/*2026*
/docs/*2026*

# cmd/comparecandidates writes one provisional model per candidate strategy
# for comparison; only the winning candidate is ever promoted to the tracked
# model.json, so these scratch outputs are never meant to be committed.
/model_old.json
/model_new.json
/model_human.json
/model_human_capped_hinge.json
/model_human_squared_hinge.json

# Local automation logs (Codex retrain loop); not part of the source tree.
/.codex_loop_logs/
