# Corpus et sorties d'essais privés par défaut, quelle que soit la date.
# Seuls les fichiers d'entrée déjà versionnés sont autorisés ici.
/data/*
!/data/focus-profile.example.json
!/data/llm_review_decisions.jsonl
!/data/llm_review_log.jsonl
!/data/reviewed_labels.csv
!/data/seed_keywords.json
!/data/policies/
/data/policies/*
!/data/policies/cti-relevance-v*.json

# Binaires, exports CSV locaux et candidats non promus.
# Le modèle de production (model.json) et son évaluation restent visibles.
/classifier
/dumptfidf
/*.csv
/model_*.json
/model_*.json.*
/.codex_loop_logs/

# Les rapports et résultats agrégés relus dans docs/ et experiments/results/
# restent visibles. Ne pas y déposer de corpus ni de résultats individuels.
