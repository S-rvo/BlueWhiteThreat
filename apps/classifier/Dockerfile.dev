# apps/classifier/Dockerfile.dev
FROM golang:1.24

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Run unit tests. Fails the build if any test is red.
RUN go test ./...

# Build the binary for a basic sanity check.
RUN go build -o classifier ./cmd/main

CMD ["go", "run", "cmd/main/main.go"]
