# apps/classifier/Dockerfile.dev — build context: repository root (shared module pkg/contract).
FROM golang:1.24

WORKDIR /app/apps/classifier

COPY pkg/contract /app/pkg/contract
COPY apps/classifier/go.mod apps/classifier/go.sum ./
RUN go mod download

COPY apps/classifier/cmd ./cmd
COPY apps/classifier/internal ./internal
COPY apps/classifier/data/seed_keywords.json ./data/seed_keywords.json

# Test code packages (local experiment output is not part of the build context).
RUN go test ./cmd/... ./internal/...

# Build the binary for a basic sanity check.
RUN go build -o classifier ./cmd/main

CMD ["go", "run", "./cmd/main"]
